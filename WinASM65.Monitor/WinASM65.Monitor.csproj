<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Moniteur 6502 interactif.

    Projet distinct de l'assembleur, qui le consomme comme bibliotheque.
    Contrainte de direction : ce projet ne doit jamais contenir de logique
    d'assemblage. Tout ce qui sait monter une source, linking, relocation ou
    emission d'octets appartient a WinASM65 ; le moniteur ne fait que
   Brancher un emulateur et piloter l'assembleur.

    Regle d'or maintenue ici : le moniteur ne parle a un emulateur que via
    IMemoryBackend. Un backend reel et le backend de test implementent la meme
    chose, ce qui permet de tester le moniteur sans lancer d'emulateur.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WinASM65.Monitor</RootNamespace>
    <AssemblyName>WinASM65.Monitor</AssemblyName>
    <StartupObject>WinASM65.Monitor.Cli.Program</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinASM65\WinASM65.csproj" />

    <!-- The host <-> plugin contract. Referenced, never redefined: the host asks
         IExecutionAdapter for what a backend can do, and a second copy of that
         interface here would be a second type identity, which is the failure the
         assembly exists to prevent. -->
    <ProjectReference Include="..\WinASM65.Monitor.Abstractions\WinASM65.Monitor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharpConsoleUI. Pinned deliberately: the API moves and the plan forbids
         opportunistic upgrades.
         2.6.16 is the pin because it is the latest release that carries a net8.0
         asset. Later releases ship lib/net10.0 only, so on net8.0 restore fails
         with NU1202. Moving the whole solution to net10.0 is not this task's
         to decide. Revisit when the solution's target framework moves, and only
         then, never opportunistically. -->
    <PackageReference Include="SharpConsoleUI" Version="2.6.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bridge travels with the executable so the monitor can start Mesen
         itself instead of depending on a script sitting in the source tree. -->
    <None Include="Bridge\**\*.lua" CopyToOutputDirectory="PreserveNewest" />

    <!-- The palette travels with it, so an edited theme is one file away from the
         binary and a missing copy still falls back to the built-in palette.
         Linked to the executable's own directory rather than to Shell\, because
         that is the first place ShellTheme.Load looks. -->
    <None Include="Shell\theme.json" Link="theme.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>