<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WinASM65</RootNamespace>
    <AssemblyName>WinASM65</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>WinASM65</Product>
    <Copyright>Copyright © 2022</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stub is 6502 source, and it is the repository's own assembler that
         turns it into the bytes a machine runs. Embedding it keeps the two from
         drifting apart: a change to the source is a change to the stub. -->
    <EmbeddedResource Include="src\TextFormat\runtime-stub.asm" LogicalName="WinASM65.TextFormat.runtime-stub.asm" />
    <!-- The GEOS stub, for the same reason: the code that walks the relocation
         table is source, assembled by this repository, and lives beside the
         writer that lays it out. -->
    <EmbeddedResource Include="src\Targets\geos-stub.asm" LogicalName="WinASM65.Targets.geos-stub.asm" />
  </ItemGroup>

</Project>
