{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WinASM65",
  "scopeName": "source.winasm65",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#label-definition" },
    { "include": "#directive" },
    { "include": "#mnemonic" },
    { "include": "#number" },
    { "include": "#register" },
    { "include": "#operator" },
    { "include": "#scope" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.winasm65",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.winasm65",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.winasm65", "match": "\\\\." }
      ]
    },
    "char": {
      "name": "string.quoted.single.winasm65",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "label-definition": {
      "comment": "A label alone on a line ends with a colon; one before an instruction starts in column 0.",
      "patterns": [
        {
          "match": "^\\s*([@.]?[A-Za-z_][A-Za-z0-9_.]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.function.label.winasm65" },
            "2": { "name": "punctuation.separator.label.winasm65" }
          }
        },
        {
          "match": "^([A-Za-z_][A-Za-z0-9_]*)(?=\\s+(?i:adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya)\\b)",
          "captures": {
            "1": { "name": "entity.name.function.label.winasm65" }
          }
        },
        {
          "comment": "NAME .res n, NAME = value",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:=|\\.(?i:res)\\b))",
          "captures": {
            "1": { "name": "variable.other.constant.winasm65" }
          }
        }
      ]
    },
    "directive": {
      "name": "keyword.control.directive.winasm65",
      "match": "(?i)(?<![A-Za-z0-9_])\\.(byte|else|end|endif|endmacro|endrep|export|if|ifdef|ifndef|import|incbin|include|macro|memarea|org|rep|res|word)\\b"
    },
    "mnemonic": {
      "name": "keyword.other.mnemonic.winasm65",
      "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya)\\b"
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.winasm65", "match": "\\$[0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.binary.winasm65", "match": "%[01]+\\b" },
        { "name": "constant.numeric.decimal.winasm65", "match": "(?<![A-Za-z_$%])\\b\\d+\\b" }
      ]
    },
    "register": {
      "name": "variable.language.register.winasm65",
      "match": "(?i)(?<=,)\\s*[xy]\\b|(?i)\\b[a]\\b(?=\\s*(?:;|$))"
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.immediate.winasm65", "match": "#" },
        { "name": "keyword.operator.winasm65", "match": "<<|>>|<=|>=|==|!=|<>|&&|\\|\\||[-+*/%~!<>=&^|]" }
      ]
    },
    "scope": {
      "name": "punctuation.section.block.winasm65",
      "match": "[{}]"
    },
    "identifier": {
      "name": "variable.other.winasm65",
      "match": "[@.]?[A-Za-z_][A-Za-z0-9_.]*"
    }
  }
}
