{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WinASM65",
  "scopeName": "source.winasm65",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#label-definition"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#equ"
    },
    {
      "include": "#pc"
    },
    {
      "include": "#mnemonic"
    },
    {
      "include": "#number"
    },
    {
      "include": "#register"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#scope"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.winasm65",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.winasm65",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.winasm65",
          "match": "\\\\."
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.winasm65",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "label-definition": {
      "comment": "A label alone on a line ends with a colon; one before an instruction starts in column 0.",
      "patterns": [
        {
          "match": "^\\s*([@.]?[A-Za-z_][A-Za-z0-9_.]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.winasm65"
            },
            "2": {
              "name": "punctuation.separator.label.winasm65"
            }
          }
        },
        {
          "match": "^([A-Za-z_][A-Za-z0-9_]*)(?=\\s+(?i:adc|alr|anc|and|arr|asl|axs|bbr0|bbr1|bbr2|bbr3|bbr4|bbr5|bbr6|bbr7|bbs0|bbs1|bbs2|bbs3|bbs4|bbs5|bbs6|bbs7|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dcp|dec|dex|dey|eor|inc|inx|iny|isc|jam|jmp|jsr|las|lax|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rla|rmb0|rmb1|rmb2|rmb3|rmb4|rmb5|rmb6|rmb7|rol|ror|rra|rti|rts|sax|sbc|sec|sed|sei|slo|smb0|smb1|smb2|smb3|smb4|smb5|smb6|smb7|sre|sta|stp|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya|wai)\\b)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.winasm65"
            }
          }
        },
        {
          "comment": "NAME .res n, NAME = value",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:=|\\.(?i:res)\\b))",
          "captures": {
            "1": {
              "name": "variable.other.constant.winasm65"
            }
          }
        },
        {
          "comment": "Anonymous labels: a line starting with a run of - or +.",
          "match": "^\\s*(-+|\\++)(?=\\s|$)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.anonymous.winasm65"
            }
          }
        }
      ]
    },
    "directive": {
      "name": "keyword.control.directive.winasm65",
      "match": "(?i)(?<![A-Za-z0-9_])\\.(addr|align|asciiz|assert|byt|byte|db|ds|dsb|dsw|dw|else|elseif|end|endif|endm|endmacro|endr|endrep|equ|error|export|fill|hibytes|if|ifdef|ifndef|import|incbin|include|lobytes|macro|memarea|org|pad|rep|rept|res|set|warning|word)\\b"
    },
    "mnemonic": {
      "name": "keyword.other.mnemonic.winasm65",
      "match": "(?i)\\b(adc|alr|anc|and|arr|asl|axs|bbr0|bbr1|bbr2|bbr3|bbr4|bbr5|bbr6|bbr7|bbs0|bbs1|bbs2|bbs3|bbs4|bbs5|bbs6|bbs7|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dcp|dec|dex|dey|eor|inc|inx|iny|isc|jam|jmp|jsr|las|lax|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rla|rmb0|rmb1|rmb2|rmb3|rmb4|rmb5|rmb6|rmb7|rol|ror|rra|rti|rts|sax|sbc|sec|sed|sei|slo|smb0|smb1|smb2|smb3|smb4|smb5|smb6|smb7|sre|sta|stp|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya|wai)\\b"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.winasm65",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.winasm65",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.winasm65",
          "match": "(?<![A-Za-z_$%])\\b\\d+\\b"
        }
      ]
    },
    "register": {
      "name": "variable.language.register.winasm65",
      "match": "(?i)(?<=,)\\s*[xy]\\b|(?i)\\b[a]\\b(?=\\s*(?:;|$))"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.immediate.winasm65",
          "match": "#"
        },
        {
          "name": "keyword.operator.winasm65",
          "match": "<<|>>|<=|>=|==|!=|<>|&&|\\|\\||[-+*/%~!<>=&^|]"
        }
      ]
    },
    "scope": {
      "name": "punctuation.section.block.winasm65",
      "match": "[{}]"
    },
    "identifier": {
      "name": "variable.other.winasm65",
      "match": "[@.]?[A-Za-z_][A-Za-z0-9_.]*"
    },
    "equ": {
      "name": "keyword.control.directive.winasm65",
      "match": "(?i)(?<=\\s)equ(?=\\s)"
    },
    "pc": {
      "name": "variable.language.pc.winasm65",
      "match": "(?<=[#(,\\s+\\-])\\*(?=\\s*($|[+\\-),;]))|^\\s*\\*(?=\\s*=)"
    }
  }
}
