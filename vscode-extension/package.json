{
  "name": "winasm65",
  "displayName": "WinASM65",
  "description": "6502 assembly for WinASM65 projects: build, debug in any emulator with a WinASM65 bridge (Mesen2 included) with source breakpoints, live diagnostics.",
  "version": "0.3.2",
  "publisher": "codewinbzn",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodewinBzn/WinASM65"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "6502",
    "nes",
    "assembly",
    "mesen",
    "emulator",
    "retro"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:winasm65",
    "onDebugDynamicConfigurations:winasm65",
    "workspaceContains:**/config.json",
    "onCommand:workbench.action.tasks.runTask",
    "onLanguage:winasm65"
  ],
  "contributes": {
    "languages": [
      {
        "id": "winasm65",
        "aliases": [
          "6502 Assembly (WinASM65)",
          "winasm65"
        ],
        "extensions": [
          ".nas",
          ".asm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "winasm65"
      }
    ],
    "debuggers": [
      {
        "type": "winasm65",
        "label": "WinASM65",
        "languages": [
          "winasm65"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "type": "string",
                "description": "The project's config.json.",
                "default": "${workspaceFolder}/config.json"
              },
              "emulatorPath": {
                "type": "string",
                "description": "The emulator's executable. Defaults to the winasm65.emulatorPath setting, then to Emulator.Path in config.json."
              },
              "emulator": {
                "type": "string",
                "examples": [
                  "mesen2",
                  "mesence"
                ],
                "description": "The emulator adapter: mesen2, mesence, or any other name for a custom emulator started with Emulator.Arguments. Defaults to Emulator.Name in config.json, then to mesen2 for a Mesen.exe."
              },
              "bridge": {
                "type": "string",
                "description": "The bridge script to load instead of the adapter's own (relative to config.json). See the bridge contract in docs/site/bridges.html."
              },
              "rom": {
                "type": "string",
                "description": "The image to run. Defaults to the build's Output.ObjectFile."
              },
              "port": {
                "type": "number",
                "description": "Bridge port; 0 picks a free one.",
                "default": 0
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on the program's first instruction: the reset vector of a cartridge, the load address of a loaded program.",
                "default": false
              },
              "connectTimeoutMs": {
                "type": "number",
                "description": "How long to wait for the bridge to answer.",
                "default": 15000
              }
            }
          },
          "attach": {
            "properties": {
              "port": {
                "type": "number",
                "description": "Port of a bridge already running in an emulator.",
                "default": 45678
              },
              "config": {
                "type": "string",
                "description": "The project's config.json, for source breakpoints. Optional.",
                "default": "${workspaceFolder}/config.json"
              },
              "stopOnAttach": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "winasm65",
            "request": "launch",
            "name": "Debug",
            "config": "${workspaceFolder}/config.json"
          }
        ],
        "configurationSnippets": [
          {
            "label": "WinASM65: Debug",
            "description": "Build the project, start the configured emulator and debug.",
            "body": {
              "type": "winasm65",
              "request": "launch",
              "name": "Debug",
              "config": "^\"\\${workspaceFolder}/config.json\""
            }
          },
          {
            "label": "WinASM65: Attach",
            "description": "Attach to an emulator already running a WinASM65 bridge.",
            "body": {
              "type": "winasm65",
              "request": "attach",
              "name": "Attach",
              "port": 45678,
              "config": "^\"\\${workspaceFolder}/config.json\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "WinASM65",
      "properties": {
        "winasm65.toolingPath": {
          "type": "string",
          "default": "",
          "description": "WinASM65.Tooling executable (or .dll, run with dotnet). Empty: the copy shipped with the extension."
        },
        "winasm65.emulatorPath": {
          "type": "string",
          "default": "",
          "description": "The emulator's executable. It takes precedence over the Path of config.json's Emulator section; a launch.json emulatorPath takes precedence over it."
        },
        "winasm65.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report assembler errors as you type and show addresses and bytes on hover."
        },
        "winasm65.ram.openOnStop": {
          "type": "boolean",
          "default": true,
          "description": "Open the Memory panel the first time a WinASM65 debug session stops."
        }
      }
    },
    "grammars": [
      {
        "language": "winasm65",
        "scopeName": "source.winasm65",
        "path": "./syntaxes/winasm65.tmLanguage.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "winasm65.mcp",
        "label": "WinASM65"
      }
    ],
    "taskDefinitions": [
      {
        "type": "winasm65",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "string",
            "description": "The project's config.json."
          }
        }
      }
    ],
    "problemPatterns": [
      {
        "name": "winasm65",
        "regexp": "^(.+?)(?::(\\d+))?: (error|warning): (.*)$",
        "file": 1,
        "line": 2,
        "severity": 3,
        "message": 4
      }
    ],
    "problemMatchers": [
      {
        "name": "winasm65",
        "owner": "winasm65",
        "source": "winasm65",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$winasm65"
      }
    ],
    "commands": [
      {
        "command": "winasm65.showListing",
        "title": "Show Listing",
        "category": "WinASM65",
        "icon": "$(list-ordered)"
      },
      {
        "command": "winasm65.hideListing",
        "title": "Hide Listing",
        "category": "WinASM65",
        "icon": "$(list-flat)"
      },
      {
        "command": "winasm65.showRam",
        "title": "Show Memory",
        "category": "WinASM65",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "winasm65.context",
          "when": "editorLangId == winasm65",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "winasm65.showListing",
          "when": "!winasm65.listingVisible"
        },
        {
          "command": "winasm65.hideListing",
          "when": "winasm65.listingVisible"
        }
      ],
      "debug/toolBar": [
        {
          "command": "winasm65.showRam",
          "when": "debugType == winasm65"
        }
      ],
      "editor/lineNumber/context": [
        {
          "submenu": "winasm65.context",
          "when": "editorLangId == winasm65",
          "group": "winasm65"
        }
      ],
      "editor/title": [
        {
          "command": "winasm65.showListing",
          "when": "editorLangId == winasm65 && !winasm65.listingVisible",
          "group": "navigation"
        },
        {
          "command": "winasm65.hideListing",
          "when": "editorLangId == winasm65 && winasm65.listingVisible",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "winasm65.context",
          "when": "resourceLangId == winasm65",
          "group": "navigation@90"
        }
      ],
      "winasm65.context": [
        {
          "command": "winasm65.showListing",
          "when": "!winasm65.listingVisible",
          "group": "1_listing"
        },
        {
          "command": "winasm65.hideListing",
          "when": "winasm65.listingVisible",
          "group": "1_listing"
        },
        {
          "command": "winasm65.showRam",
          "when": "inDebugMode && debugType == winasm65",
          "group": "2_debug"
        }
      ]
    },
    "submenus": [
      {
        "id": "winasm65.context",
        "label": "WinASM65"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run tooling && npm run license && vsce package --target win32-x64",
    "tooling": "dotnet publish ../WinASM65.Tooling/WinASM65.Tooling.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:DebugType=none -maxcpucount:1 -o bin",
    "license": "node -e \"require('fs').copyFileSync('../LICENSE.txt', 'LICENSE.txt')\"",
    "test": "tsc -p ./ && node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
